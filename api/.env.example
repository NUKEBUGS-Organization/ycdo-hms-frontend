NODE_ENV=development
PORT=3000

# Local Postgres (or CapRover internal URL in production)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ycdo_hms?schema=public

# Must match prisma/seed-constants.ts SEED_BRANCH_ID / SEED_BRANCH_CODE
BRANCH_ID=a0000001-0000-4000-8000-000000000001
BRANCH_CODE=CH

CORS_ORIGIN=http://localhost:5173

# After migrate:
#   npx prisma migrate deploy   # or migrate dev
#   npx prisma db seed
#   npm run test:concurrency    # API must be running
